---
import Badge from "@/layouts/components/Badge.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { DigitalMarketingSection } from "@/types";

const entry = await getListPage("digitalMarketingSection", "digital-marketing");
const data: DigitalMarketingSection = entry.data;
const { services, stats } = data;
---

{
  data.enable && services.enable && (
    <section id="services" class="section relative isolate overflow-hidden">
      <div class="container">
        <div class="section-container">
          <div class="section-intro centralize">
            <Badge title={services.badge} />
            <h2 class="title hasHighlight" set:html={markdownify(services.title)} />
            <p class="subtitle">{services.content}</p>
          </div>
          <div class="section-content">
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {services.items.map((item) => (
                <article class="p-7 rounded-2xl bg-white/5 border border-border ring-1 ring-white/5 transition-colors duration-300 hover:border-primary/50 flex flex-col gap-4">
                  <div class="size-12 rounded-xl bg-primary/15 grid place-items-center">
                    <DynamicIcon
                      icon={item.icon}
                      className="text-primary-light text-xl"
                    />
                  </div>
                  <h3 class="text-h5-sm font-bold text-white leading-snug">
                    {item.title}
                  </h3>
                  <p class="text-text">{item.description}</p>
                </article>
              ))}
            </div>

            {stats.enable && stats.items.length > 0 && (
              <div class="grid grid-cols-3 gap-2 mt-10">
                {stats.items.map((stat) => (
                  <div class="text-center p-6 lg:p-10 rounded-2xl bg-primary/10">
                    <div class="text-h2 lg:text-h1 leading-none font-bold font-secondary text-white mb-3">
                      {stat.value}
                    </div>
                    <p class="text-text text-h6">{stat.label}</p>
                  </div>
                ))}
              </div>
            )}

            {services.statement?.enable && (
              <div class="mt-14 xl:mt-19 p-8 lg:p-12 rounded-2xl bg-light/6 border border-border text-center">
                <p class="text-sm font-semibold uppercase tracking-wider text-primary-light mb-4">
                  {services.statement.badge}
                </p>
                <h2
                  class="title hasHighlight mb-4"
                  set:html={markdownify(services.statement.title)}
                />
                <p class="subtitle mx-auto mb-8">
                  {services.statement.content}
                </p>
                {services.statement.button.enable && (
                  <a
                    href={services.statement.button.link}
                    class="btn btn-primary"
                  >
                    {services.statement.button.label}
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
      <GradientBlob />
    </section>
  )
}
