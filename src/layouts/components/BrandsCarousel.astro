---
import { getListPage } from "@/lib/contentParser.astro";
import type { BrandsSection } from "@/types";

const brandsInfo = await getListPage("brandsSection", "brands");
const brandsData: BrandsSection = brandsInfo.data;
if (!brandsData.enable) return;

const brandUrls = brandsData.images.map((img) => img.src);
---

{
  brandsData.enable && (
    <section id="brands" class="section-sm pt-16 xl:pt-20">
      <div class="container">
        <div class="text-center mb-10">
          <p
            class="text-text-light text-base lg:text-lg"
            set:html={brandsData.title}
          />
        </div>
        <div
          class="flex flex-wrap gap-x-10 gap-y-8 lg:gap-x-12 justify-center items-center [&>img]:h-10 [&>img]:w-auto [&>img]:opacity-80 [&>img]:transition-opacity [&>img]:duration-300 [&>img]:lg:h-12 hover:[&>img]:opacity-100"
          data-trusted-brands-images={JSON.stringify(brandUrls)}
        >
          {/* <!-- Handled by script: main.js updateTrustedPartners() --> */}
        </div>
      </div>
    </section>
  )
}
