---
import config from "@/config/config.json";

const { src }: { src?: string } = Astro.props;
const { logo_text, title } = config.site;
const logoSrc = src ?? "/images/brand/logo-mark.webp";
---

<a href="/" class="navbar-brand inline-flex items-center gap-3">
  {
    logoSrc ? (
      <>
        <img
          src={logoSrc}
          width="293"
          height="160"
          alt=""
          aria-hidden="true"
          class="h-9 w-auto shrink-0 md:h-10"
        />
        <span class="flex flex-col leading-none">
          <span class="font-secondary text-base font-semibold uppercase tracking-[0.12em] text-white md:text-lg">
            {logo_text}
          </span>
          <span class="mt-1.5 font-primary text-[0.55rem] font-medium uppercase tracking-[0.22em] text-text-dark">
            Websites · Software · Automation
          </span>
        </span>
      </>
    ) : (
      title
    )
  }
</a>
