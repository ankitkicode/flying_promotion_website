---
import Badge from "@/layouts/components/Badge.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { DigitalMarketingSection } from "@/types";

const entry = await getListPage("digitalMarketingSection", "digital-marketing");
const data: DigitalMarketingSection = entry.data;
const { contact } = data;
---

{
  data.enable && contact.enable && (
    <section id="contact" class="section relative isolate overflow-hidden">
      <div class="container">
        <div class="section-container">
          <div class="section-intro centralize">
            <Badge title={contact.badge} />
            <h2
              class="title hasHighlight"
              set:html={markdownify(contact.title)}
            />
            <p class="subtitle">{contact.content}</p>
          </div>
          <div class="section-content">
            <div class="max-w-5xl mx-auto p-8 lg:p-10 rounded-2xl bg-white/5 border border-border ring-1 ring-white/5">
              <h3 class="text-h5-sm font-bold font-secondary text-white mb-8 text-center">
                Get in Touch
              </h3>
              <div class="grid md:grid-cols-3 gap-8">
                {contact.items.map((item) => {
                  const Container = item.link ? "a" : "div";
                  return (
                    <Container
                      href={item.link}
                      class="flex items-start gap-4"
                    >
                      <div class="size-12 shrink-0 rounded-xl bg-primary/15 grid place-items-center">
                        <DynamicIcon
                          icon={item.icon}
                          className="text-primary-light text-lg"
                        />
                      </div>
                      <div>
                        <p class="text-sm text-text-dark">{item.label}</p>
                        <p class="font-medium text-white">{item.value}</p>
                      </div>
                    </Container>
                  );
                })}
              </div>

              {contact.button.enable && (
                <div class="flex justify-center mt-10">
                  <a href={contact.button.link} class="btn btn-primary">
                    {contact.button.label}
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
      <GradientBlob />
    </section>
  )
}
